REVIEWDOG_VERSION=0.21.3

# 镜像仓库 (不含镜像名, 替换为实际私有仓库地址)
REGISTRY=registry.example.com/your-team

# 本地手动运行 (docker compose run) 的 GitLab 侧配置
# 注意: reviewdog 不读 CI_PROJECT_ID, 项目定位用 owner/repo 路径形式
CI_API_V4_URL=https://git.example.com/api/v4
CI_REPO_OWNER=
CI_REPO_NAME=
CI_MERGE_REQUEST_IID=
CI_COMMIT_SHA=
CI_MERGE_REQUEST_DIFF_BASE_SHA=
REVIEWDOG_GITLAB_API_TOKEN=
